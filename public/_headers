# Cloudflare Pages reads this at deploy time.
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(), accelerometer=(), camera=(), geolocation=(), payment=()
  # Everything happens in the page: your files, your card. It talks to nothing.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'

# Bot Fight Mode on stephen8n.com injects an inline script into every HTML page,
# which the CSP above refuses (a console error, nothing more). no-transform asks
# Cloudflare not to inject; it stays off /assets so the bundle is still compressed.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/assets/*
  Cache-Control: public, max-age=31536000, immutable
